# bracket.env: the GPU machine's values for serve.sh. Copy, fill in, keep the filled copy private (it names paths
# and cards). ". bracket.env" before serve.sh.
export WORK=/path/to/bracket                  # the run's folder: these scripts in run/, compiled kernels, logs
export RUN=$WORK/run
export BIN=/path/to/bin/llama-server          # Miner Llama v3 (1551f5fe1)
export MOUNTS="/path/to/models /path/to/build"  # folders the server container reads, mounted at the same path
# the two files (first shard; the other shards beside it) and their cards, as docker device lists
export MODEL_q2=/path/to/Swift-Qwen3.8-Flash-Next-GSQ-RCO-Q2_0-00001-of-00003.gguf
export MODEL_iq3s=/path/to/Swift-Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00003.gguf
export GPUS_q2=0,1,2
export GPUS_iq3s=3,4,5
# llama-server on the loopback, one port per file (the dashboard's endpoints, through tunnel.sh)
export PORT_q2=18210 PORT_iq3s=18220
# only for PROXY=1: proxy.py and common.py from llms-on-crypto-mining-rigs bench/agent_check
export AGENT_CHECK=$WORK/agent_check
